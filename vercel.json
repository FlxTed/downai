{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "node scripts/prepare-vercel-build.mjs && npm run sync-downloads && npm run website:build",
  "build": {
    "env": {
      "DOWNAI_WINDOWS_DOWNLOAD_URL": "https://downai.vercel.app/downloads/DownAI-Setup-1.0.0.exe",
      "DOWNAI_MAC_DOWNLOAD_URL": "https://downai.vercel.app/downloads/DownAI-1.0.0.dmg"
    }
  },
  "outputDirectory": "packages/meridian-website/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.downai.dev/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/downloads/manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
    },
    {
      "source": "/downloads/:file*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
