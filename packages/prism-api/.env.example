# Copy:  copy .env.example .env
# Keys:  see SETUP.md

DOWNAI_PROVIDER=groq

GROQ_API_KEY=PASTE_YOUR_GROQ_KEY_HERE
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=PASTE_YOUR_OPENAI_KEY_HERE
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_KEY_HERE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_SITE_URL=https://downai.dev
OPENROUTER_APP_NAME=DownAI

MISTRAL_API_KEY=PASTE_YOUR_MISTRAL_KEY_HERE
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest

DEEPSEEK_API_KEY=PASTE_YOUR_DEEPSEEK_KEY_HERE
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

DOWNAI_FREE_DAILY_LIMIT=10
DOWNAI_PROMPT_DAILY_LIMIT=8
DOWNAI_LICENSE_SECRET=generate-a-long-random-secret-here
DOWNAI_SESSION_SECRET=generate-another-long-random-secret-here
DOWNAI_MAX_DEVICES_PER_KEY=3
DOWNAI_CORS_ORIGINS=https://downai.dev,https://www.downai.dev,http://localhost:5173,http://localhost:5174,http://localhost:5175
PORT=8787

STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
DOWNAI_EMAIL_FROM=DownAI <support@downai.dev>
